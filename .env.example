# Copy this file to .env and fill in your values.
# DO NOT commit the actual .env file to GitHub.

# Server
PORT=5000

# MySQL / MariaDB (local XAMPP defaults)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pcte_alumni_db

# For cloud MySQL providers that give a full connection URL (Render, Railway, PlanetScale)
# If set, the individual DB_* values above are ignored.
# DATABASE_URL=mysql://user:password@host:3306/dbname

# Set DB_SSL=true when connecting to cloud-hosted MySQL that requires SSL
DB_SSL=false

# JWT signing secret — change this to a long random string before deploying!
JWT_SECRET=replace_this_with_a_long_random_secret_min_32_chars

# Frontend origin for CORS (no trailing slash)
# For local development with Live Server: http://127.0.0.1:5500
FRONTEND_ORIGIN=http://127.0.0.1:5500
