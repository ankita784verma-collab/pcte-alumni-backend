# Copy to .env for local use. Never commit .env.
PORT=5000
NODE_ENV=development

# PostgreSQL: either a full URL (Render/Neon/Supabase) ...
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# ... or individual values for a local database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=pcte_alumni_db
DB_SSL=false

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Your Vercel frontend URL(s), comma separated, no trailing slash
FRONTEND_ORIGIN=http://127.0.0.1:5500
